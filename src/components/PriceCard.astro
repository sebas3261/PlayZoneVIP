---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  title: string;
  total: string;
  perPerson: string;
  ctaHref: string;
}

const { icon, title, total, perPerson, ctaHref } = Astro.props;
---

<div
  class="flex h-[210px] w-[190px] flex-col justify-between border-l border-black/10 px-4 py-2 text-center first:border-l-0"
>
  <div class="flex flex-col items-center">
    <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-sm ring-1 ring-black/5">
      <Icon name={icon} class="h-6 w-6 text-[#713478]" />
    </div>

    <h4 class="text-[14px] font-semibold text-gray-900 mb-1">
      {title}
    </h4>

    <p class="text-[18px] font-extrabold text-gray-900">{total}</p>
    <p class="text-[12px] font-semibold text-[#8C90A0]">{perPerson}</p>
  </div>

  <a
    href={ctaHref}
    target="_blank"
    rel="noopener noreferrer"
    class="w-full flex items-center justify-center gap-2 rounded-lg py-3
           text-white text-[13px] font-bold
           bg-gradient-to-br from-[#713478] to-[#b76cbf]
           shadow-[0_8px_18px_rgba(113,52,120,0.24)]
           hover:brightness-110
           active:translate-y-[1px]
           transition-all duration-300
           focus:outline-none focus:ring-2 focus:ring-[#b76cbf]/60"
  >
    Reservar
  </a>
</div>
