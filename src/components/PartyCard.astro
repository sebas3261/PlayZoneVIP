---
import { Icon } from "astro-icon/components";

interface DetailsSection {
  title: string;
  items: string[];
}

interface Props {
  image: string;
  title: string;
  subTitle: string;
  people: string;
  time: string;
  price: string;
  features?: string[];
  details?: DetailsSection[];
  notes?: string[];
  ctaText?: string;
  ctaHref?: string;
}

const {
  image,
  title,
  subTitle,
  people,
  time,
  price,
  features = [],
  details = [],
  notes = [],
  ctaText = "Reservar ahora",
  ctaHref = "#",
} = Astro.props;
---

<div
  class="
    group flex w-full overflow-hidden rounded-xl bg-white font-text
    shadow-[0_16px_42px_rgba(18,18,28,0.10)] ring-1 ring-black/5
    transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_58px_rgba(18,18,28,0.15)]
    flex-col lg:min-h-[300px] lg:flex-row
  "
>
  <div class="relative h-[230px] w-full overflow-hidden lg:h-auto lg:w-[34%]">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/72 via-black/18 to-transparent"></div>
    <span class="absolute right-4 top-4 rounded-lg bg-white px-3 py-2 text-sm font-extrabold text-[#713478] shadow-[0_10px_24px_rgba(0,0,0,0.18)] lg:hidden">
      {price}
    </span>
    <div class="absolute bottom-4 left-4 right-4">
      <h3 class="font-title text-2xl font-bold leading-tight text-white">
        {title}
      </h3>
      <p class="mt-1 text-sm font-semibold text-white/85">{subTitle}</p>
    </div>
  </div>

  <div class="flex min-h-0 flex-1 flex-col p-5 md:p-6 lg:w-[66%]">
    <div class="mb-5 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div class="grid grid-cols-2 gap-3 text-sm font-semibold text-[#31313c] md:min-w-[300px]">
        <span class="flex items-center justify-center gap-2 rounded-lg bg-[#f2eef4] px-3 py-3">
        <Icon name="mdi:account-group" class="h-5 w-5 text-[#713478]" />
        {people}
        </span>
        <span class="flex items-center justify-center gap-2 rounded-lg bg-[#f2eef4] px-3 py-3">
        <Icon name="mdi:clock-outline" class="h-5 w-5 text-[#713478]" />
        {time}
        </span>
      </div>

      <div class="hidden rounded-xl bg-[#f7f7fa] px-5 py-4 text-right lg:block">
        <span class="block text-xs font-bold uppercase tracking-[0.14em] text-[#828292]">Desde</span>
        <strong class="block text-2xl text-[#713478]">{price}</strong>
      </div>
    </div>

    {features.length > 0 && (
      <ul class="mb-5 grid gap-2 text-sm leading-5 text-[#626271] md:grid-cols-2">
        {features.map((f) => (
          <li class="flex items-start gap-2">
            <Icon name="mdi:check-circle-outline" class="mt-[1px] h-5 w-5 shrink-0 text-[#713478]" />
            <span>{f}</span>
          </li>
        ))}
      </ul>
    )}

    {(details.length > 0 || notes.length > 0) && (
      <div class="grid gap-3 md:grid-cols-2">
        {details.map((section) => (
          <div class="rounded-lg bg-[#f7f7fa] p-4">
            <h4 class="mb-2 text-sm font-bold text-gray-900">{section.title}</h4>
            <ul class="space-y-1 text-sm text-[#626271]">
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}

        {notes.length > 0 && (
          <div class="rounded-lg border border-black/5 bg-[#fbfbfc] p-4">
            <h4 class="mb-2 text-sm font-bold text-gray-900">Notas:</h4>
            <ul class="space-y-1 text-xs leading-5 text-[#626271]">
              {notes.map((note) => <li>{note}</li>)}
            </ul>
          </div>
        )}
      </div>
    )}

    <div class="mt-auto pt-5 lg:max-w-[230px]">
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="
          w-full flex items-center justify-center gap-2 rounded-lg py-3
          text-white text-sm font-bold
          bg-gradient-to-br from-[#713478] to-[#b76cbf]
          shadow-[0_8px_18px_rgba(113,52,120,0.24)]
          hover:brightness-110
          active:translate-y-[1px]
          transition-all duration-300
          focus:outline-none focus:ring-2 focus:ring-[#b76cbf]/60
        "
      >
        <Icon name="mdi:calendar-check" class="w-5 h-5" />
        {ctaText}
      </a>
    </div>
  </div>
</div>
