---
import { Icon } from "astro-icon/components";

interface Props {
  image: string;
  title: string;
  subTitle: string;
  people: string;
  time: string;
  features?: string[];
  tag?: string;
  reverse?: boolean;
  link?: string;
}

const {
  image,
  title,
  subTitle,
  people,
  time,
  features = [],
  tag = "Experiencia",
  reverse = false,
  link = "#",
} = Astro.props;

const lower = title.toLowerCase();
const phone = lower.includes("pádel") || lower.includes("padel") ? "573105655602" : "573132485526";
const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(`Hola, quiero más información sobre ${title}`)}`;
---

<div
  class:list={[
    "group w-full font-text",
    "grid gap-6 border-t border-black/10 py-9 first:border-t-0 md:py-12",
    "lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-10",
    reverse && "lg:flex-row-reverse",
    reverse && "lg:grid-cols-[1.05fr_0.95fr]",
  ]}
>
  <a
    href={link}
    class:list={[
      "relative block h-[240px] w-full overflow-hidden rounded-xl md:h-[340px] lg:h-[390px]",
      reverse && "lg:order-2",
    ]}
    aria-label={`Ver ${title}`}
  >
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <span class="absolute left-5 top-5 rounded-full bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-[#713478] shadow-sm">
      {tag}
    </span>
    <h3 class="absolute bottom-5 left-5 right-5 font-title text-2xl font-bold text-white md:text-3xl">
      {title}
    </h3>
  </a>

  <div class:list={["flex flex-col", reverse && "lg:order-1"]}>
    <span class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-[#713478]">
      {tag}
    </span>
    <h3 class="font-title text-3xl leading-tight text-[#20202a] md:text-5xl">
      {title}
    </h3>
    <p class="mt-4 max-w-[620px] text-sm leading-7 text-[#626271] md:text-base">
      {subTitle}
    </p>

    <div class="my-6 flex flex-wrap gap-3 text-sm font-semibold text-[#31313c]">
      <span class="flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm ring-1 ring-black/5">
        <Icon name="mdi:account-group" class="h-5 w-5 text-[#713478]" />
        {people}
      </span>
      <span class="flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm ring-1 ring-black/5">
        <Icon name="mdi:clock-outline" class="h-5 w-5 text-[#713478]" />
        {time}
      </span>
    </div>

    {features.length > 0 && (
      <ul class="mb-7 grid gap-3 text-sm text-[#626271] md:grid-cols-3">
        {features.map((feature) => (
          <li class="flex items-start gap-2">
            <Icon name="mdi:check-circle-outline" class="mt-0.5 h-5 w-5 shrink-0 text-[#713478]" />
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={link}
        class="
          flex items-center justify-center gap-2 rounded-lg px-5 py-3
          text-white text-sm font-semibold
          bg-gradient-to-br from-[#713478] to-[#b76cbf]
          shadow-[0_8px_18px_rgba(113,52,120,0.24)]
          hover:brightness-110
          active:translate-y-[1px]
          transition-all duration-300
          focus:outline-none focus:ring-2 focus:ring-[#b76cbf]/60
        "
      >
        <Icon name="mdi:information-outline" class="w-5 h-5" />
        Más información
      </a>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="
          group relative overflow-hidden
          rounded-lg text-sm font-semibold
          border border-[#b76cbf] text-[#713478]
          flex items-center justify-center gap-2 px-5 py-3
          transition-all duration-300
          focus:outline-none focus:ring-2 focus:ring-[#b76cbf]/60
          cursor-pointer
        "
      >
        <span
          aria-hidden
          class="
            absolute inset-0
            bg-gradient-to-br from-[#713478] to-[#b76cbf]
            opacity-0 group-hover:opacity-100
            transition-opacity duration-300
          "
        ></span>
        <span
          class="
            relative z-10 flex items-center gap-2
            transition-colors duration-300
            group-hover:text-white
          "
        >
          <Icon name="mdi:whatsapp" class="w-5 h-5" />
          Contáctanos
        </span>
      </a>
    </div>
  </div>
</div>
