---
import { Icon } from "astro-icon/components";

interface Props {
  image: string;
  srcSet?: string;
  activity: string;
  description: string;
  link: string;
}

const { image, srcSet, activity, description, link } = Astro.props;
---

<div
  class="group h-[342px] w-[326px] overflow-hidden rounded-xl bg-white
         ring-1 ring-black/5 shadow-[0_16px_42px_rgba(18,18,28,0.11)] flex flex-col
         transition-all duration-500 ease-out
         hover:-translate-y-1 hover:shadow-[0_24px_58px_rgba(18,18,28,0.17)]"
>
  <a href={link} class="relative h-[198px] flex items-end overflow-hidden" aria-label={`Ver ${activity}`}>
    <img
      src={image}
      srcset={srcSet}
      sizes="326px"
      alt={activity}
      width="326"
      height="198"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.05]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/78 via-black/26 to-transparent"></div>
    <div class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-[#713478] shadow-[0_10px_24px_rgba(0,0,0,0.22)] transition-transform duration-300 group-hover:scale-105">
      <Icon name="mdi:arrow-top-right" class="h-5 w-5" />
    </div>
    <div class="relative z-10 w-full p-4">
      <span class="mb-2 inline-flex rounded-full bg-white/18 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-white backdrop-blur">
        Actividad
      </span>
      <h3 class="text-2xl font-bold leading-tight text-white">
        {activity}
      </h3>
    </div>
  </a>

  <div class="flex flex-1 flex-col p-4">
    <p class="text-sm leading-6 text-[#626271]">{description}</p>
    <a
      href={link}
      class="mt-auto flex items-center justify-between rounded-lg border border-[#713478]/18
             bg-[#f7f7fa] px-4 py-3 text-sm font-bold text-[#713478]
             transition-all duration-300 hover:border-[#713478]/35 hover:bg-[#f2eef4]"
    >
      <span>Ver mas</span>
      <Icon name="mdi:arrow-right" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" />
    </a>
  </div>
</div>
