---
import Layout from "@/layouts/Layout.astro";
import EscapeCard from "@/components/EscapeCard.astro";
import PriceCard from "@/components/PriceCard.astro";
---

<Layout
  title="Escape Room"
  description="Pon a prueba tu mente y trabaja en equipo en el Escape Room de Playzone VIP. Desbloquea pistas, resuelve acertijos y vive una experiencia única llena de misterio y diversión."
  keywords={["escape room", "juego de escape", "acertijos", "misterio", "actividades en grupo", "Playzone VIP"]}
  canonical="/escaperoom-game"
  openGraph={{
    title: "Escape Room | Playzone VIP",
    description:
      "Atrévete a vivir la experiencia del Escape Room en Playzone VIP. Resuelve enigmas, colabora con tu equipo y escapa antes de que se acabe el tiempo.",
    url: "https://playzonevip.com/escaperoom-game",
    images: [{ url: "/og-escape-room.webp", width: 1200, height: 630, alt: "Escape Room en Playzone VIP" }],
  }}
>
  <main class="bg-[#f7f7fa] font-text">
    <section class="relative flex min-h-[520px] items-end overflow-hidden">
      <img
        src="/images/Escape/escapeHeader.webp"
        alt="Escape room en Playzone VIP"
        width="800"
        height="600"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/62 via-black/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#f7f7fa] to-transparent"></div>
      <div class="relative z-10 mx-auto w-full max-w-[1120px] px-5 pb-12 pt-32 text-white md:px-8">
        <span class="mb-4 inline-flex rounded-full border border-white/30 bg-white/15 px-4 py-1 text-xs font-bold uppercase tracking-[0.18em] backdrop-blur">
          Domingo a domingo - 2 PM a 11 PM
        </span>
        <h1 class="font-title text-4xl leading-tight md:text-6xl">Escape room</h1>
        <p class="mt-4 max-w-[700px] text-sm font-semibold leading-7 text-white/90 md:text-base">
          Reúne a tu equipo, resuelve pistas y sal antes de que se acabe el
          tiempo. Dos salas, dos historias y 60 minutos para demostrarlo.
        </p>
      </div>
    </section>

    <section class="px-5 py-12 md:px-8 md:py-14">
      <div class="mx-auto mb-8 max-w-[1120px]">
        <span class="mb-3 inline-flex rounded-full bg-white px-4 py-1 text-xs font-bold uppercase tracking-[0.16em] text-[#713478] shadow-sm">
          Salas
        </span>
        <h2 class="text-2xl font-bold text-[#31313c]">Escoge tu historia</h2>
        <p class="mt-2 max-w-[720px] text-sm leading-6 text-[#6f6f7d]">
          Cada sala tiene narrativa, pistas y retos distintos para grupos de 2 a 6 personas.
        </p>
      </div>

      <div class="mx-auto grid max-w-[1120px] gap-6 md:grid-cols-2">
        <EscapeCard
          image="/images/Escape/escapeSaw.webp"
          title="SAW"
          subTitle={"Jigsaw ha atrapado a tu grupo de amigos y los tiene encerrados en una habitación aterradora.\nTienen 60 minutos para descifrar sus macabros acertijos, usar cada recurso disponible y trabajar en equipo para escapar con vida. ¿Lograrán salir antes de que sea demasiado tarde? "}
          people="2 - 6"
          time="1h"
          link="https://wa.me/573132485526?text=Hola,%20quiero%20más%20información%20sobre%20el%20scape%20de%20saw"
        />
        <EscapeCard
          image="/images/Escape/escapeAsesino.webp"
          title="En Busca del Asesino"
          subTitle={"¡El famoso millonario ha sido asesinado en su propia mansión!\nAhora tienes 60 minutos para descubrir quién cometió el crimen, con qué arma y en qué lugar sucedió. Explora la escena, sigue las pistas, resuelve los acertijos y reúne todas las pruebas.\nSolo los mejores detectives podrán armar el caso y hacer su declaración final antes de que el tiempo se agote."}
          people="2 - 6"
          time="1h"
          link="https://wa.me/573132485526?text=Hola,%20quiero%20más%20información%20sobre%20el%20scape%20de%20en%20busqueda%20del%20asesino"
        />
      </div>
    </section>

    <section class="px-5 pb-5 md:px-8">
      <div class="mx-auto max-w-[1120px]">
        <span class="mb-3 inline-flex rounded-full bg-white px-4 py-1 text-xs font-bold uppercase tracking-[0.16em] text-[#713478] shadow-sm">
          Precios
        </span>
        <h2 class="text-2xl font-bold text-[#31313c]">Tarifas por grupo</h2>
        <p class="mt-2 max-w-[720px] text-sm leading-6 text-[#6f6f7d]">
          El precio varía según el número de personas en tu grupo.
        </p>
      </div>
    </section>

    <section
      class="scroll-hide flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth px-5 pb-20 md:px-8 md:pb-24 justify-start md:justify-center lg:overflow-x-visible"
    >
      <div class="snap-center shrink-0">
        <PriceCard
          icon="mdi:account-multiple-outline"
          title="2 personas"
          total="$100.000 cop"
          perPerson="$50.000 / persona"
          ctaHref="https://wa.me/573132485526?text=Quiero%20reservar%20para%202%20personas"
        />
      </div>

      <div class="snap-center shrink-0">
        <PriceCard
          icon="mdi:account-group-outline"
          title="3 personas"
          total="$130.000 cop"
          perPerson="$44.000 / persona"
          ctaHref="https://wa.me/573132485526?text=Quiero%20reservar%20para%203%20personas"
        />
      </div>

      <div class="snap-center shrink-0">
        <PriceCard
          icon="mdi:account-group-outline"
          title="4 personas"
          total="$135.000 cop"
          perPerson="$45.000 / persona"
          ctaHref="https://wa.me/573132485526?text=Quiero%20reservar%20para%204%20personas"
        />
      </div>

      <div class="snap-center shrink-0">
        <PriceCard
          icon="mdi:account-group-outline"
          title="5 personas"
          total="$160.000 cop"
          perPerson="$40.000 / persona"
          ctaHref="https://wa.me/573132485526?text=Quiero%20reservar%20para%205%20personas"
        />
      </div>

      <div class="snap-center shrink-0">
        <PriceCard
          icon="mdi:account-group-outline"
          title="6 personas"
          total="$175.000 cop"
          perPerson="$35.000 / persona"
          ctaHref="https://wa.me/573132485526?text=Quiero%20reservar%20para%206%20personas"
        />
      </div>
    </section>
  </main>
</Layout>
