---
import Layout from "@/layouts/Layout.astro";
import ActivityCard from "@/components/ActivityCard.astro";
import { Icon } from "astro-icon/components";

const waUrl = `https://wa.me/573132485526?text=${encodeURIComponent(
  "Hola, quiero reservar una actividad en Playzone VIP"
)}`;

const activities = [
  {
    image: "/images/Actividades/futbolCard.webp",
    title: "Canchas sinteticas",
    subTitle: "Es hora de vivir la adrenalina con tus amigos.",
    time: "1h",
    people: "10-16",
    tag: "Futbol",
    features: [
      "Cesped sintetico e iluminacion",
      "Ideal para partidos y torneos",
      "Espacio amplio para grupos",
    ],
    link: "/canchas",
  },
  {
    image: "/images/Actividades/padelCard.webp",
    title: "Padel",
    subTitle: "¡Que empiece el juego! Tenemos todo listo para que mejores tus habilidades.",
    time: "1h 30m",
    people: "4",
    tag: "Cancha",
    features: [
      "Canchas techadas",
      "Perfecto para parejas o dobles",
      "Ambiente competitivo y social",
    ],
    link: "/padel",
  },
  {
    image: "/images/Actividades/paintballCard.webp",
    title: "Paintball",
    subTitle: "¡Reúne a tu equipo, carga tu marcadora y prepárate para la batalla!",
    time: "1h",
    people: "20",
    tag: "Aventura",
    features: [
      "Escenarios para estrategia",
      "Equipamiento de proteccion",
      "Plan fuerte para grupos grandes",
    ],
    link: "/paintball",
  },
  {
    image: "/images/Actividades/escapeCard.webp",
    title: "Escape room",
    subTitle: "Afina tu lógica y prepárate para un reto lleno de adrenalina.",
    time: "1h",
    people: "6",
    tag: "Reto",
    features: [
      "Acertijos y narrativa inmersiva",
      "Trabajo en equipo",
      "Experiencia bajo presion",
    ],
    link: "/escaperoom-game",
  },
];
---

<Layout
  title="Nuestras actividades"
  description="Descubre todas las actividades deportivas y recreativas que tenemos para ti en Playzone VIP: fútbol, pádel, paintball y mucho más."
  keywords={["actividades", "fútbol", "pádel", "paintball", "escape room", "Playzone VIP"]}
  canonical="/actividades"
  openGraph={{
    title: "Nuestras actividades | Playzone VIP",
    description:
      "Vive la emoción del deporte y la aventura. Descubre nuestras actividades: fútbol, pádel, paintball y escape room en Playzone VIP, Chía.",
    url: "https://playzonevip.com/actividades",
    images: [{ url: "/og-actividades.webp", width: 1200, height: 630, alt: "Actividades deportivas en Playzone VIP" }],
  }}
>
  <main class="bg-[#f7f7fa] pt-24 font-text md:pt-30">
    <section class="border-b border-black/10 px-5 pb-12 md:px-8 md:pb-14">
      <div class="mx-auto grid max-w-[1120px] gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <span class="mb-4 inline-flex rounded-full bg-white px-4 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#713478] shadow-sm">
            Playzone VIP
          </span>
          <h2 class="font-title text-3xl leading-tight md:text-5xl">
            Nuestras Actividades
          </h2>
          <p class="mt-5 max-w-[640px] text-sm leading-7 text-[#6f6f7d] md:text-base">
            Elige el tipo de plan que quieres vivir: deporte, competencia,
            estrategia o aventura. Aquí encuentras todas las experiencias de
            Playzone en un recorrido claro, con detalles para decidir más fácil.
          </p>
        </div>

        <div class="grid gap-4">
          <div class="flex items-center gap-3 border-b border-black/10 pb-4">
            <Icon name="mdi:calendar-check" class="h-7 w-7 shrink-0 text-[#713478]" />
            <div>
              <h3 class="font-bold text-[#31313c]">Reserva facil</h3>
              <p class="text-sm text-[#6f6f7d]">Agenda por WhatsApp.</p>
            </div>
          </div>
          <div class="flex items-center gap-3 border-b border-black/10 pb-4">
            <Icon name="mdi:account-group" class="h-7 w-7 shrink-0 text-[#713478]" />
            <div>
              <h3 class="font-bold text-[#31313c]">Planes para grupos</h3>
              <p class="text-sm text-[#6f6f7d]">Amigos, familia y eventos.</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <Icon name="mdi:map-marker" class="h-7 w-7 shrink-0 text-[#713478]" />
            <div>
              <h3 class="font-bold text-[#31313c]">Todo en un lugar</h3>
              <p class="text-sm text-[#6f6f7d]">Deporte y aventura.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 py-10 md:px-8 md:py-12">
      <div class="mx-auto max-w-[1120px]">
        <div class="mb-7 flex flex-col justify-between gap-3 md:flex-row md:items-end">
          <div>
            <h3 class="text-2xl font-bold text-[#31313c]">Escoge tu experiencia</h3>
            <p class="mt-2 max-w-[620px] text-sm leading-6 text-[#6f6f7d]">
              Cada actividad tiene su propio ambiente, capacidad y ritmo.
            </p>
          </div>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-fit items-center gap-2 rounded-lg bg-[#713478] px-5 py-3 text-sm font-bold text-white shadow-[0_10px_24px_rgba(113,52,120,0.22)] transition-all duration-300 hover:-translate-y-0.5"
          >
            <Icon name="mdi:whatsapp" class="h-5 w-5" />
            Preguntar disponibilidad
          </a>
        </div>

        <div class="grid gap-7">
          {activities.map((activity, index) => (
            <ActivityCard {...activity} reverse={index % 2 === 1} />
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1120px] px-5 pb-20 md:px-8 md:pb-24">
      <div class="rounded-xl bg-[#713478] px-6 py-7 text-white shadow-[0_22px_60px_rgba(113,52,120,0.24)] md:px-8 md:py-8 lg:rounded-2xl">
        <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-[650px]">
            <h3 class="text-2xl font-bold leading-tight">
              ¿Ya sabes que quieres jugar?
            </h3>
            <p class="mt-3 text-sm font-semibold leading-6 text-white/85">
              Escríbenos y te ayudamos a escoger la actividad según el tamaño del grupo,
              el tiempo disponible y el tipo de plan.
            </p>
          </div>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-bold text-[#713478] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#f2eef4] md:w-auto"
          >
            <Icon name="mdi:whatsapp" class="h-5 w-5" />
            Reservar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
