---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const reservaSemanaUrl =
  "https://wa.me/573132485526?text=" +
  encodeURIComponent(
    "Hola, quiero reservar una cancha de futbol entre semana para el horario de "
  );

const reservaFinSemanaUrl =
  "https://wa.me/573132485526?text=" +
  encodeURIComponent("Hola, quiero reservar una cancha de futbol para el fin de semana.");
---

<Layout
  title="Canchas de Fútbol"
  description="Reserva las mejores canchas sintéticas de fútbol en Playzone VIP, Chía. Espacios amplios, iluminación profesional y todo lo que necesitas para tu partido perfecto."
  keywords={["canchas de fútbol", "canchas sintéticas", "reservar cancha", "fútbol 5", "fútbol 7", "fútbol en Chía", "Playzone VIP"]}
  canonical="/canchas"
  openGraph={{
    title: "Canchas de Fútbol | Playzone VIP",
    description:
      "Juega con tus amigos en las mejores canchas sintéticas de Chía. Reserva tu espacio en Playzone VIP y vive la pasión del fútbol con instalaciones de primera.",
    url: "https://playzonevip.com/canchas",
    images: [
      { url: "/og-canchas.webp", width: 1200, height: 630, alt: "Canchas de fútbol en Playzone VIP" },
    ],
  }}
>
  <main class="bg-[#f7f7fa] font-text">
    <section class="relative flex min-h-[520px] items-end overflow-hidden">
      <img
        src="/images/Canchas/canchasHeader.webp"
        alt="Canchas header"
        width="1600"
        height="900"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[center_70%]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/62 via-black/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#f7f7fa] to-transparent"></div>
      <div class="relative z-10 mx-auto w-full max-w-[1120px] px-5 pb-12 pt-32 text-white md:px-8">
        <span class="mb-4 inline-flex rounded-full border border-white/30 bg-white/15 px-4 py-1 text-xs font-bold uppercase tracking-[0.18em] backdrop-blur">
          Domingo a domingo - 8 AM a 11 PM
        </span>
        <h1 class="font-title text-4xl leading-tight md:text-6xl">
          Canchas Sinteticas
        </h1>
        <p class="mt-4 max-w-[640px] text-sm font-semibold leading-7 text-white/90 md:text-base">
          Canchas de césped sintético para partidos con amigos, entrenamientos
          y torneos. Reserva por horario y llega listo para jugar.
        </p>
      </div>
    </section>

    <section class="px-5 py-12 md:px-8 md:py-14">
      <div class="mx-auto grid max-w-[1120px] gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <img
        src="/images/Canchas/canchasMain.webp"
        alt="Nuestras canchas"
        width="800"
        height="600"
        loading="lazy"
        class="h-[260px] w-full rounded-xl object-cover object-center shadow-[0_18px_50px_rgba(18,18,28,0.12)] md:h-[420px]"
      />
      <div>
        <span class="mb-3 inline-flex rounded-full bg-white px-4 py-1 text-xs font-bold uppercase tracking-[0.16em] text-[#713478] shadow-sm">
          Instalaciones
        </span>
        <h2 class="mb-4 font-title text-3xl text-[#20202a] md:text-4xl">Nuestras canchas</h2>
        <p class="mb-6 text-sm leading-7 text-[#626271] md:text-base">
          Cancha profesional de césped sintético de última generación,
          perfecta para partidos competitivos y entrenamientos de cualquier
          nivel. Equipamiento completo y mantenimiento diario.
        </p>
        <ul class="grid gap-3 text-sm text-[#626271] sm:grid-cols-2">
          <li class="flex items-center gap-2 rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-black/5">
            <Icon name="mdi:check-circle-outline" class="h-5 w-5 text-[#713478]" />
            Totalmente cerradas con malla
          </li>
          <li class="flex items-center gap-2 rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-black/5">
            <Icon name="mdi:check-circle-outline" class="h-5 w-5 text-[#713478]" />
            Iluminación profesional
          </li>
          <li class="flex items-center gap-2 rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-black/5">
            <Icon name="mdi:check-circle-outline" class="h-5 w-5 text-[#713478]" />
            Zona de graderías
          </li>
          <li class="flex items-center gap-2 rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-black/5">
            <Icon name="mdi:check-circle-outline" class="h-5 w-5 text-[#713478]" />
            Medidas reglamentarias
          </li>
        </ul>
      </div>
      </div>
    </section>

    <section class="px-5 pb-20 md:px-8 md:pb-24">
      <div class="mx-auto mb-8 max-w-[1120px]">
        <span class="mb-3 inline-flex rounded-full bg-white px-4 py-1 text-xs font-bold uppercase tracking-[0.16em] text-[#713478] shadow-sm">
          Precios
        </span>
        <h2 class="text-2xl font-bold text-[#31313c]">Tarifas por horario</h2>
        <p class="mt-2 max-w-[720px] text-sm leading-6 text-[#6f6f7d]">
          El precio varía únicamente según el horario de tu reserva.
        </p>
      </div>

      <div class="mx-auto grid max-w-[1120px] gap-8 border-t border-black/10 pt-8 lg:grid-cols-2">
      <div class="text-xs md:text-base">
        <h4 class="font-semibold">Lunes a viernes</h4>
        <p class="text-[#828292] mb-5">Precio según el horario</p>

        <div class="space-y-2">
          <div class="flex items-center justify-between h-[58px] bg-[#F8F8F8] px-5 rounded-xl font-semibold">
            <div class="flex items-center md:gap-2">
              <Icon name="mdi:clock-outline" class="w-[20px] h-[20px]" />
              8:00 AM - 4:00 PM
            </div>
            <p>$70.000 <span class="font-normal">cop</span></p>
          </div>
          <div class="flex items-center justify-between h-[58px] bg-[#F8F8F8] px-5 rounded-xl font-semibold">
            <div class="flex items-center md:gap-2">
              <Icon name="mdi:clock-outline" class="w-[20px] h-[20px]" />
              4:00 PM – 6:00 PM
            </div>
            <p>$80.000 <span class="font-normal">cop</span></p>
          </div>
          <div class="flex items-center justify-between h-[58px] bg-[#F8F8F8] px-5 rounded-xl font-semibold">
            <div class="flex items-center md:gap-2">
              <Icon name="mdi:clock-outline" class="w-[20px] h-[20px]" />
              6:00 PM – 7:00 PM
            </div>
            <p>$90.000 <span class="font-normal">cop</span></p>
          </div>
          <div class="flex items-center justify-between h-[58px] bg-[#F8F8F8] px-5 rounded-xl font-semibold">
            <div class="flex items-center md:gap-2">
              <Icon name="mdi:clock-outline" class="w-[20px] h-[20px]" />
              7:00 PM – 9:00 PM
            </div>
            <p>$105.000 <span class="font-normal">cop</span></p>
          </div>
          <div class="flex items-center justify-between h-[58px] bg-[#F8F8F8] px-5 rounded-xl font-semibold mb-10">
            <div class="flex items-center md:gap-2">
              <Icon name="mdi:clock-outline" class="w-[20px] h-[20px]" />
              9:00 PM – 10:00 PM
            </div>
            <p>$90.000 <span class="font-normal">cop</span></p>
          </div>
          <a
            href={reservaSemanaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full rounded-lg bg-gradient-to-br from-[#713478] to-[#b76cbf] text-center text-white py-3 sm:py-3.5 text-sm sm:text-base font-bold shadow-[0_8px_18px_rgba(113,52,120,0.24)] hover:brightness-110 active:translate-y-[1px] transition"
          >
            Reservar ahora
          </a>
        </div>
      </div>

      <div class="flex flex-col justify-between border-t border-black/10 pt-6 text-xs md:text-base lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <div>
          <div class="flex items-start justify-between gap-4 mb-5 sm:mb-6">
            <div class="min-w-0">
              <h4 class="font-semibold text-gray-900 leading-tight">
                Sábados, Domingos y Festivos
              </h4>
              <p class="text-gray-500 text-sm">Disponible todo el día</p>
            </div>

            <span class="shrink-0 rounded-xl bg-[#E9EBEF] text-gray-800 text-xs sm:text-sm px-3 py-1.5">
              Tarifa fija
            </span>
          </div>

          <div class="mb-5 border-y border-black/10 py-6 sm:mb-6 sm:py-7">
            <div class="text-center">
              <div class="font-extrabold text-3xl sm:text-4xl text-gray-900 tracking-tight">
                $85.000 <span class="font-bold">cop</span>
              </div>
              <div class="text-gray-500 text-sm sm:text-base mt-1">por hora</div>

              <div class="mt-3 inline-flex items-center gap-2 text-gray-500 text-sm sm:text-base">
                <svg viewBox="0 0 24 24" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
                <span>Cualquier horario disponible</span>
              </div>
            </div>
          </div>

          <ul class="space-y-2 text-gray-600 text-sm sm:text-base mb-5 sm:mb-6">
            <li class="flex gap-2">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-gray-400"></span>
              <span>Ideal para partidos de fin de semana</span>
            </li>
            <li class="flex gap-2">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-gray-400"></span>
              <span>Disponibilidad desde las 8:00 AM</span>
            </li>
            <li class="flex gap-2">
              <span class="mt-1 h-1.5 w-1.5 rounded-full bg-gray-400"></span>
              <span>Reserva anticipada recomendada</span>
            </li>
          </ul>
        </div>

        <a
          href={reservaFinSemanaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full rounded-lg bg-gradient-to-br from-[#713478] to-[#b76cbf] text-center text-white py-3 sm:py-3.5 text-sm sm:text-base font-bold shadow-[0_8px_18px_rgba(113,52,120,0.24)] hover:brightness-110 active:translate-y-[1px] transition"
        >
          Reservar ahora
        </a>
      </div>
      </div>
    </section>
  </main>
</Layout>
