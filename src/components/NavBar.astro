---
import { Icon } from "astro-icon/components";

const pathname = new URL(Astro.request.url).pathname;
const transparentOnTop = pathname === "/";
---

<header
  id="site-header"
  data-transparent-on-top={transparentOnTop ? "true" : "false"}
  class:list={[
    "fixed top-0 left-0 right-0 z-50 text-sm",
    "transition-[background-color,color,box-shadow] duration-300",
    transparentOnTop
      ? "bg-transparent text-white shadow-none"
      : "bg-white text-black shadow-sm md:backdrop-saturate-150",
  ]}
>
  <a href="#main" class="sr-only focus:not-sr-only">Saltar al contenido</a>

  <div class="pt-[env(safe-area-inset-top)]">
    <div class="h-14 md:h-16 flex items-center justify-between px-5 md:px-10 lg:px-16">
      <a href="/" class="flex items-center gap-3">
        <img
          src="/LogoNoBackground.webp"
          alt="PlayZone VIP"
          width="40"
          height="40"
          class="w-10 h-10"
        />
        <h1 class="font-title text-base">PLAYZONE VIP</h1>
      </a>

      <nav aria-label="Principal" class="hidden md:block">
        <ul class="flex items-center gap-10 lg:gap-16 font-text font-semibold">
          <li>
            <a
              class="relative after:absolute after:left-0 after:-bottom-1 after:h-[2px] after:w-0 after:bg-current after:transition-all hover:after:w-full"
              href="/">Inicio</a>
          </li>
          <li>
            <a
              class="relative after:absolute after:left-0 after:-bottom-1 after:h-[2px] after:w-0 after:bg-current after:transition-all hover:after:w-full"
              href="/actividades">Actividades</a>
          </li>
          <li>
            <a
              class="relative after:absolute after:left-0 after:-bottom-1 after:h-[2px] after:w-0 after:bg-current after:transition-all hover:after:w-full"
              href="/fiestasinfantiles">Fiestas infantiles</a>
          </li>
        </ul>
      </nav>

      <div class="flex items-center gap-3 font-text font-semibold">
        <a
          id="contact-button"
          href="/contacto"
          class:list={[
            "p-2 px-6 rounded-3xl transition-colors duration-300 hidden md:flex",
            transparentOnTop
              ? "bg-white text-black hover:bg-white/90"
              : "bg-black text-white hover:bg-black/85",
          ]}
        >
          Contáctanos
        </a>

        <button
          id="mobile-menu-button"
          type="button"
          class:list={[
            "md:hidden inline-flex items-center justify-center rounded-full p-2",
            "transition-colors duration-200",
            transparentOnTop
              ? "text-white hover:bg-white/10"
              : "text-black hover:bg-black/10",
          ]}
          aria-label="Abrir menú"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <Icon name="material-symbols:menu-rounded" class="w-7 h-7 menu-icon-open" />
          <Icon name="material-symbols:close-rounded" class="w-7 h-7 menu-icon-close hidden" />
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    aria-hidden="true"
    class="md:hidden fixed inset-0 z-[90] pointer-events-none"
  >
    <div
      id="mobile-menu-overlay"
      class="absolute inset-0 backdrop-blur-sm transition-opacity duration-300 bg-black/50 opacity-0"
    >
    </div>

    <div
      id="mobile-menu-panel"
      class="absolute top-0 right-0 w-[85%] max-w-[420px] h-full z-[100] bg-white text-black shadow-xl transition-transform duration-300 ease-out translate-x-full flex flex-col"
    >
      <div class="flex items-center justify-between px-5 py-4 border-b border-black/10">
        <div class="flex items-center gap-3">
          <img src="/LogoNoBackground.webp" alt="PlayZone VIP" width="28" height="28" class="w-7 h-7" />
          <span class="font-title">PLAYZONE VIP</span>
        </div>
        <button
          id="mobile-menu-close"
          type="button"
          class="p-2 rounded-full hover:bg-black/10 transition-colors"
          aria-label="Cerrar menú"
        >
          <Icon name="material-symbols:close-rounded" class="w-6 h-6" />
        </button>
      </div>

      <nav aria-label="Navegación móvil" class="px-5 py-4">
        <ul class="flex flex-col gap-2">
          <li>
            <a
              href="/"
              class="mobile-link flex items-center gap-3 rounded-xl px-3 py-3 hover:bg-black/5 active:bg-black/10 transition-colors font-text font-semibold"
            >
              <Icon name="solar:home-2-linear" class="w-5 h-5" />
              <span>Inicio</span>
            </a>
          </li>
          <li>
            <a
              href="/actividades"
              class="mobile-link flex items-center gap-3 rounded-xl px-3 py-3 hover:bg-black/5 active:bg-black/10 transition-colors font-text font-semibold"
            >
              <Icon name="solar:widget-6-linear" class="w-5 h-5" />
              <span>Actividades</span>
            </a>
          </li>
          <li>
            <a
              href="/fiestasinfantiles"
              class="mobile-link flex items-center gap-3 rounded-xl px-3 py-3 hover:bg-black/5 active:bg-black/10 transition-colors font-text font-semibold"
            >
              <Icon name="solar:balloon-linear" class="w-5 h-5" />
              <span>Fiestas infantiles</span>
            </a>
          </li>
          <li class="pt-2">
            <a
              href="/contacto"
              class="mobile-link flex items-center justify-center gap-2 rounded-2xl px-4 py-3 bg-black text-white hover:bg-black/85 transition-colors font-text font-semibold"
            >
              <Icon name="solar:phone-linear" class="w-5 h-5" />
              <span>Contáctanos</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="mt-auto px-5 py-4 border-t border-black/10 text-xs text-black/60">
        © <span id="footer-year"></span> PlayZone VIP · Todos los derechos reservados
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header") as HTMLElement | null;
  const contactBtn = document.getElementById("contact-button");
  const menuBtn = document.getElementById("mobile-menu-button");
  const closeBtn = document.getElementById("mobile-menu-close");
  const menu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("mobile-menu-overlay");
  const panel = document.getElementById("mobile-menu-panel");
  const links = document.querySelectorAll<HTMLAnchorElement>(".mobile-link");
  const yearEl = document.getElementById("footer-year");
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());

  const transparentOnTop = header?.dataset.transparentOnTop === "true";
  const triggerOffset = 12;

  const solidClasses = ["bg-white", "text-black", "shadow-sm", "md:backdrop-saturate-150"];
  const transparentClasses = ["bg-transparent", "text-white", "shadow-none"];

  const contactSolid = ["bg-black", "text-white", "hover:bg-black/85"];
  const contactTransparent = ["bg-white", "text-black", "hover:bg-white/90"];

  const burgerSolid = ["text-black", "hover:bg-black/10"];
  const burgerTransparent = ["text-white", "hover:bg-white/10"];

  function applySolid(solid: boolean) {
    if (!header) return;
    header.classList.remove(...(solid ? transparentClasses : solidClasses));
    header.classList.add(...(solid ? solidClasses : transparentClasses));

    if (contactBtn) {
      contactBtn.classList.remove(...(solid ? contactTransparent : contactSolid));
      contactBtn.classList.add(...(solid ? contactSolid : contactTransparent));
    }
    if (menuBtn) {
      menuBtn.classList.remove(...(solid ? burgerTransparent : burgerSolid));
      menuBtn.classList.add(...(solid ? burgerSolid : burgerTransparent));
    }
  }

  let ticking = false;
  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > triggerOffset;
        const solid = !transparentOnTop || scrolled;
        applySolid(solid);
        ticking = false;
      });
      ticking = true;
    }
  }
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  function setMenu(open: boolean) {
    if (!menu || !overlay || !panel || !menuBtn) return;
    menuBtn.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-hidden", String(!open));
    menu.classList.toggle("pointer-events-none", !open);
    menu.classList.toggle("pointer-events-auto", open);
    overlay.classList.toggle("opacity-100", open);
    overlay.classList.toggle("opacity-0", !open);
    panel.classList.toggle("translate-x-0", open);
    panel.classList.toggle("translate-x-full", !open);
    document.body.style.overflow = open ? "hidden" : "";

    const openIcon = menuBtn.querySelector(".menu-icon-open");
    const closeIcon = menuBtn.querySelector(".menu-icon-close");
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  menuBtn?.addEventListener("click", () => {
    const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
    setMenu(!isOpen);
  });
  closeBtn?.addEventListener("click", () => setMenu(false));
  overlay?.addEventListener("click", () => setMenu(false));
  links.forEach((l) => l.addEventListener("click", () => setMenu(false)));
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>
