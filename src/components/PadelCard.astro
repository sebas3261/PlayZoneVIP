---
import { Icon } from "astro-icon/components";
import ButtonModal from "./ButtonModal.astro";

interface Props {
  image: string;
  title: string;
  subTitle: string;
  people: string;
  time: string;
  id?: number;
  link?: string;
}

const { image, title, subTitle, people, time, link = "#", id = 1 } = Astro.props;
---

<div
  class="
    group grid w-full gap-5 border-t border-black/10 py-8 font-text first:border-t-0
    md:grid-cols-[0.9fr_1.1fr] md:items-center
  "
>
  <div class="relative h-[220px] w-full overflow-hidden rounded-xl md:h-[280px]">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <h3 class="absolute bottom-4 left-4 right-4 font-title text-2xl font-bold text-white">
      {title}
    </h3>
  </div>

  <div class="flex flex-col">
    <p class="text-sm leading-6 text-[#626271]">{subTitle}</p>

    <div class="my-5 grid grid-cols-2 gap-3 text-sm font-semibold text-[#31313c]">
      <span class="flex items-center justify-center gap-2 rounded-lg bg-[#f2eef4] px-3 py-3">
        <Icon name="mdi:account-group" class="h-5 w-5 text-[#713478]" />
        {people}
      </span>
      <span class="flex items-center justify-center gap-2 rounded-lg bg-[#f2eef4] px-3 py-3">
        <Icon name="mdi:clock-outline" class="h-5 w-5 text-[#713478]" />
        {time}
      </span>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={link}
        class="
          w-full flex items-center justify-center gap-2 rounded-lg px-4 py-3
          text-white text-sm font-bold
          bg-gradient-to-br from-[#713478] to-[#b76cbf]
          shadow-[0_8px_18px_rgba(113,52,120,0.24)]
          hover:brightness-110
          active:translate-y-[1px]
          transition-all duration-300
          focus:outline-none focus:ring-2 focus:ring-[#b76cbf]/60
        "
      >
        <Icon name="mdi:information-outline" class="w-5 h-5" />
        Mas información
      </a>

      {id == 1 && <ButtonModal />}
    </div>
  </div>
</div>
