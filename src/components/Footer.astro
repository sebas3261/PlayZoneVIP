---
import { Icon } from "astro-icon/components";

const itemHover =
  "inline-flex w-fit transition-colors duration-300 hover:text-white text-sm text-white/72";
---

<footer role="contentinfo" class="bg-[#030213] font-text text-white">
  <div class="mx-auto max-w-[1380px] px-5 py-7 md:px-8 md:py-8 lg:px-12">
    <div class="grid gap-7 border-b border-white/12 pb-6 lg:grid-cols-[1.1fr_0.85fr_1fr]">
      <div>
        <a href="/" class="mb-3 flex w-fit items-center gap-3">
          <img
            src="/LogoNoBackground.webp"
            alt="PlayZone VIP"
            width="44"
            height="44"
            class="h-11 w-11"
          />
          <h2 class="font-title text-xl">PLAYZONE VIP</h2>
        </a>
      <p class="max-w-[46ch] text-sm leading-5 text-white/72">
        Tu centro de entretenimiento deportivo donde la diversión no tiene
        límites. Fútbol, pádel, paintball y escape room en un solo lugar.
      </p>

      <div class="mt-4 flex gap-3">
        <a
          href="https://www.facebook.com/playzonevip10"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/8 text-white/72 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:text-[#1877F2]"
        >
          <Icon name="ic:baseline-facebook" class="w-6 h-6" aria-hidden="true" />
        </a>

        <a
          href="https://www.instagram.com/playzonevip10"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/8 text-white/72 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:text-[#E1306C]"
        >
          <Icon name="mdi:instagram" class="w-6 h-6" aria-hidden="true" />
        </a>

        <a
          href="https://x.com/playzonevip"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/8 text-white/72 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:text-[#1DA1F2]"
        >
          <Icon name="prime:twitter" class="w-6 h-6" aria-hidden="true" />
        </a>

        <a
          href="https://wa.me/573132485526"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/8 text-white/72 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:text-[#25D366]"
        >
          <Icon name="ic:baseline-whatsapp" class="w-6 h-6" aria-hidden="true" />
        </a>
      </div>
    </div>

      <nav aria-label="Enlaces rápidos">
        <h3 class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-white">Enlaces</h3>
        <div class="grid grid-cols-2 gap-8">
          <ul class="flex flex-col gap-2">
            <li><a href="/" class={itemHover}>Inicio</a></li>
            <li><a href="/actividades" class={itemHover}>Actividades</a></li>
            <li><a href="/fiestasinfantiles" class={itemHover}>Fiestas infantiles</a></li>
            <li><a href="/canchas" class={itemHover}>Fútbol</a></li>
          </ul>
          <ul class="flex flex-col gap-2">
            <li><a href="/padel" class={itemHover}>Padel</a></li>
            <li><a href="/paintball" class={itemHover}>Paintball</a></li>
            <li><a href="/escaperoom-game" class={itemHover}>Escape Room</a></li>
            <li><a href="/contacto" class={itemHover}>Contacto</a></li>
          </ul>
        </div>
      </nav>

      <address class="not-italic">
        <h3 class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-white">Contacto</h3>
        <ul class="flex flex-col gap-3 text-sm text-white/72">
          <li class="flex items-start gap-2">
            <Icon name="mdi:location" class="mt-0.5 h-5 w-5 shrink-0 text-[#b76cbf]" aria-hidden="true" />
            <a
              href="https://maps.google.com/?q=PlayZone+VIP+Ch%C3%ADa+Cra+9+Vereda+Bojac%C3%A1"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors duration-300 hover:text-white"
            >
              Cra. 9, Vereda Bojacá / Km 1 vía Chía-Cajicá, Chía
            </a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="ic:baseline-phone" class="h-5 w-5 shrink-0 text-[#b76cbf]" aria-hidden="true" />
            <a href="tel:+573132485526" class="transition-colors duration-300 hover:text-white">
              +57 313 248 5526
            </a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="mdi:clock-outline" class="h-5 w-5 shrink-0 text-[#b76cbf]" aria-hidden="true" />
            <span>L–D 8:00 AM – 11:00 PM</span>
          </li>
        </ul>
      </address>
    </div>

    <div class="flex flex-col gap-3 pt-5 text-xs text-white/58 md:flex-row md:items-center md:justify-between">
      <p>
        © 2025 PlayZone VIP. Desarrollado por
        <a
          href="https://www.linkedin.com/in/sebastian-sanchez-sandoval-3ab3b327a"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/78 transition-colors duration-300 hover:text-white"
        >
          Sebastian Sanchez
        </a>
      </p>
    <ul class="flex flex-col gap-2 sm:flex-row sm:gap-4">
      <li><a href="/cookies" class={itemHover}>Cookies</a></li>
      <li><a href="/politica-privacidad" class={itemHover}>Política de privacidad</a></li>
      <li><a href="/aviso-legal" class={itemHover}>Aviso legal</a></li>
    </ul>
    </div>
  </div>
</footer>
