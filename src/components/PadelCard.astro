---
import { Icon } from "astro-icon/components";
import ButtonModal from "./ButtonModal.astro";

interface Props {
  image: string;
  title: string;
  subTitle: string;
  people: string;
  time: string;
  id?: number;
  link?: string;
}

const { image, title, subTitle, people, time, link = "#", id = 1 } = Astro.props;
---

<div
  class="
    w-full max-w-[566px]
    overflow-hidden rounded-2xl bg-white font-text
    shadow-[0_4px_10px_3px_rgba(0,0,0,0.3)]
    flex flex-col
    md:w-[566px] md:h-[590px]
    transition-all duration-300 hover:scale-[1.02]
  "
>
  <div class="w-full aspect-[566/290] h-[240px] md:aspect-auto md:h-[290px]">
    <img src={image} alt={title} loading="lazy" class="w-full h-full object-cover" />
  </div>

  <div class="flex flex-col p-6 flex-1">
    <h3 class="text-xl md:text-2xl font-bold mb-2 text-gray-900 font-title">
      {title}
    </h3>
    <p class="text-gray-700 text-base md:text-lg mb-4">{subTitle}</p>

    <div class="flex justify-between items-center text-base md:text-lg text-gray-600 mb-6">
      <span class="flex items-center gap-2">
        <Icon name="mdi:account-group" class="w-6 h-6 text-gray-700" />
        {people}
      </span>
      <span class="flex items-center gap-2">
        <Icon name="mdi:clock-outline" class="w-6 h-6 text-gray-700" />
        {time}
      </span>
    </div>

    <div class="mt-auto flex flex-col gap-3 md:flex-row md:gap-4">
      <a
        href={link}
        class="
          w-full flex items-center justify-center gap-2 py-3
          text-white rounded-xl text-sm md:text-base font-semibold
          bg-black
          shadow-[0_4px_10px_rgba(0,0,0,0.3)]
          hover:shadow-[0_6px_15px_rgba(0,0,0,0.4)]
          active:translate-y-[1px]
          transition-all duration-300
          focus:outline-none focus:ring-2 focus:ring-[#b76cbf]/60
        "
      >
        <Icon name="mdi:information-outline" class="w-5 h-5" />
        Mas información
      </a>

      {id == 1 && <ButtonModal />}
    </div>
  </div>
</div>
