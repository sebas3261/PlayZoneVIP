---
import { Icon } from "astro-icon/components";

interface DetailsSection {
  title: string;
  items: string[];
}

interface Props {
  image: string;
  title: string;
  subTitle: string;
  people: string;
  time: string;
  price: string;
  features?: string[];
  details?: DetailsSection[];
  notes?: string[];
  ctaText?: string;
  ctaHref?: string;
}

const {
  image,
  title,
  subTitle: _subTitle,
  people,
  time,
  price,
  features = [],
  details = [],
  notes = [],
  ctaText = "Reserva aquí",
  ctaHref = "#",
} = Astro.props;
---

<div
  class="
    w-full max-w-[566px]
    overflow-hidden rounded-2xl bg-white font-text
    shadow-[0_4px_10px_3px_rgba(0,0,0,0.3)]
    flex flex-col
    md:w-[566px]
  "
>
  <div class="w-full aspect-[566/290] h-[240px] md:aspect-auto md:h-[290px] relative">
    <img src={image} alt={title} loading="lazy" class="absolute inset-0 w-full h-full object-cover rounded-lg" />
  </div>

  <div class="flex flex-col p-6 flex-1">
    <div class="flex justify-between items-center mb-2">
      <h3 class="text-xl md:text-2xl font-extrabold text-gray-900 font-title">
        {title}
      </h3>
      <span class="text-sm md:text-xl font-bold text-gray-800 bg-gray-100 px-3 py-1 rounded-lg">
        {price}
      </span>
    </div>

    <div class="flex justify-between items-center text-base md:text-lg text-gray-700 mb-4">
      <span class="flex items-center gap-2">
        <Icon name="mdi:account-group" class="w-6 h-6" />
        {people}
      </span>
      <span class="flex items-center gap-2">
        <Icon name="mdi:clock-outline" class="w-6 h-6" />
        {time}
      </span>
    </div>

    {features.length > 0 && (
      <ul class="space-y-2 text-gray-700 text-sm md:text-base mb-5">
        {features.map((f) => (
          <li class="flex items-start gap-2">
            <Icon name="mdi:check-circle-outline" class="w-5 h-5 mt-[2px]" />
            <span>{f}</span>
          </li>
        ))}
      </ul>
    )}

    {details.map((section) => (
      <div class="mb-3">
        <h4 class="font-semibold text-gray-900 mb-1">{section.title}</h4>
        <ul class="text-gray-700 text-sm md:text-base list-disc ml-5 space-y-1">
          {section.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}

    {notes.length > 0 && (
      <div class="mt-2">
        <h4 class="font-semibold text-gray-900 mb-1">Notas:</h4>
        <ul class="text-gray-700 text-sm md:text-base list-disc ml-5 space-y-1">
          {notes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    )}

    <div class="mt-auto pt-5">
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="
          w-full flex items-center justify-center gap-2 py-3
          text-white rounded-xl text-sm md:text-base font-semibold
          bg-gradient-to-br from-[#713478] to-[#b76cbf]
          shadow-[0_4px_10px_rgba(0,0,0,0.3)]
          hover:shadow-[0_6px_15px_rgba(0,0,0,0.4)]
          active:translate-y-[1px]
          transition-all duration-300
          focus:outline-none focus:ring-2 focus:ring-[#b76cbf]/60
        "
      >
        <Icon name="mdi:calendar-check" class="w-5 h-5" />
        {ctaText}
      </a>
    </div>
  </div>
</div>
