---
import Layout from "@/layouts/Layout.astro";
import ButtonModal from "@/components/ButtonModal.astro";
import { Icon } from "astro-icon/components";

const reservaCanchaUrl =
  "https://wa.me/573105655602?text=Hola,%20quiero%20reservar%20para%20jugar%20p%C3%A1del.";

const clasesUrl =
  "https://wa.me/573105655602?text=Hola,%20quiero%20informaci%C3%B3n%20de%20clases%20de%20p%C3%A1del.";
---

<Layout
  title="Pádel"
  description="Descubre las mejores canchas de pádel en Playzone VIP, Chía. Reserva fácilmente y vive la experiencia deportiva más divertida con tus amigos o en torneos."
  keywords={["pádel", "canchas de pádel", "reservar pádel", "pádel Chía", "torneos de pádel", "Playzone VIP"]}
  canonical="/padel"
  openGraph={{
    title: "Canchas de Pádel | Playzone VIP",
    description:
      "Juega pádel en Playzone VIP: canchas profesionales, iluminación ideal y ambiente deportivo en Chía. Reserva tu turno y vive la experiencia VIP.",
    url: "https://playzonevip.com/padel",
    images: [{ url: "/og-padel.webp", width: 1200, height: 630, alt: "Canchas de pádel en Playzone VIP" }],
  }}
>
  <main class="bg-white font-text">
    <section class="relative flex min-h-[560px] items-end overflow-hidden">
      <img
        src="/images/Padel/padelHeader.webp"
        alt="Canchas de pádel en Playzone VIP"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/62 via-black/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white to-transparent"></div>
      <div class="relative z-10 mx-auto w-full max-w-[1120px] px-5 pb-16 pt-32 text-white md:px-8">
        <span class="mb-4 inline-flex rounded-full border border-white/30 bg-white/15 px-4 py-1 text-xs font-bold uppercase tracking-[0.18em] backdrop-blur">
          Domingo a domingo - 8 AM a 11 PM
        </span>
        <h1 class="font-title text-5xl leading-tight md:text-7xl">Padel</h1>
        <p class="mt-4 max-w-[640px] text-sm font-semibold leading-7 text-white/90 md:text-base">
          El deporte que más crece, en canchas profesionales para jugar,
          entrenar y competir con tu parche.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href={reservaCanchaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-bold text-[#713478] shadow-[0_12px_30px_rgba(0,0,0,0.22)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#f2eef4]"
          >
            <Icon name="mdi:calendar-check" class="h-5 w-5" />
            Reservar cancha
          </a>
          <a
            href={clasesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/40 bg-white/10 px-5 py-3 text-sm font-bold text-white backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/20"
          >
            <Icon name="mdi:school-outline" class="h-5 w-5" />
            Clases
          </a>
        </div>
      </div>
    </section>

    <section class="px-5 py-12 md:px-8 md:py-16">
      <div class="mx-auto grid max-w-[1120px] gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <span class="mb-3 inline-flex rounded-full bg-[#f2eef4] px-4 py-1 text-xs font-bold uppercase tracking-[0.16em] text-[#713478]">
            Canchas y clases
          </span>
          <h2 class="font-title text-3xl text-[#20202a] md:text-5xl">
            ¡Que empiece el juego!
          </h2>
          <p class="mt-4 text-sm leading-7 text-[#626271] md:text-base">
            Tenemos todo listo para que entrenes, te retes, mejores y disfrutes al máximo. Contamos con dos canchas de pádel profesionales, perfectas para entrenar o jugar con tu parche, y profesores que te acompañan en cada punto.
          </p>
          <div class="mt-7 grid gap-3 sm:grid-cols-3">
            <div class="border-t border-black/10 pt-4">
              <strong class="block text-2xl text-[#713478]">2</strong>
              <span class="text-sm font-semibold text-[#6f6f7d]">Canchas</span>
            </div>
            <div class="border-t border-black/10 pt-4">
              <strong class="block text-2xl text-[#713478]">1h 30m</strong>
              <span class="text-sm font-semibold text-[#6f6f7d]">Reserva</span>
            </div>
            <div class="border-t border-black/10 pt-4">
              <strong class="block text-2xl text-[#713478]">1-4</strong>
              <span class="text-sm font-semibold text-[#6f6f7d]">Clases</span>
            </div>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl shadow-[0_18px_50px_rgba(18,18,28,0.12)]">
          <div class="relative aspect-video w-full bg-black">
            <video
              data-autoplay-video
              data-src="/videos/padel-tour.mp4"
              poster="/images/Padel/padelHeader.webp"
              class="absolute inset-0 h-full w-full object-cover"
              autoplay
              muted
              loop
              playsinline
              preload="none"
            ></video>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/28 via-transparent to-transparent"></div>
            <div class="pointer-events-none absolute bottom-4 left-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-[#713478] shadow-sm">
              Tour Padel
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#f7f7fa] px-5 py-12 md:px-8 md:py-16">
      <div class="mx-auto max-w-[1120px]">
        <div class="mb-8 max-w-[680px]">
          <h2 class="text-2xl font-bold text-[#31313c]">Elige como jugar</h2>
        <p class="mt-2 max-w-[680px] text-sm leading-6 text-[#6f6f7d]">
          Reserva una cancha o agenda clases con profesor según tu nivel.
        </p>
      </div>

        <div class="grid border-t border-black/10 lg:grid-cols-2">
          <article class="grid gap-5 border-b border-black/10 py-8 lg:border-b-0 lg:border-r lg:pr-8">
            <img
              src="/images/Padel/padelReserva.webp"
              alt="Reserva de cancha de padel"
              loading="lazy"
              class="h-[240px] w-full rounded-xl object-cover md:h-[300px]"
            />
            <div>
              <h3 class="font-title text-3xl text-[#20202a]">Reserva tu cancha</h3>
              <p class="mt-3 text-sm leading-7 text-[#626271]">
                Pista profesional con cristal panorámico y césped artificial de competición.
                Agenda tu turno y arma el mejor partido.
              </p>
              <div class="my-5 flex flex-wrap gap-3 text-sm font-semibold text-[#31313c]">
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm ring-1 ring-black/5">
                  <Icon name="mdi:account-group" class="h-5 w-5 text-[#713478]" />
                  4 jugadores
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm ring-1 ring-black/5">
                  <Icon name="mdi:clock-outline" class="h-5 w-5 text-[#713478]" />
                  1h 30m
                </span>
              </div>
              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  href={reservaCanchaUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-br from-[#713478] to-[#b76cbf] px-5 py-3 text-sm font-bold text-white shadow-[0_8px_18px_rgba(113,52,120,0.24)] transition-all duration-300 hover:-translate-y-0.5 hover:brightness-110"
                >
                  <Icon name="mdi:calendar-check" class="h-5 w-5" />
                  Reservar
                </a>
                <div class="sm:w-[180px]">
                  <ButtonModal />
                </div>
              </div>
            </div>
          </article>

          <article class="grid gap-5 py-8 lg:pl-8">
            <img
              src="/images/Padel/padelClases.webp"
              alt="Clases de padel"
              loading="lazy"
              class="h-[240px] w-full rounded-xl object-cover md:h-[300px]"
            />
            <div>
              <h3 class="font-title text-3xl text-[#20202a]">Clases con profesor</h3>
              <p class="mt-3 text-sm leading-7 text-[#626271]">
                Aprende los fundamentos del pádel y perfecciona tu técnica y estrategia
                con nuestros profes certificados.
              </p>
              <div class="my-5 flex flex-wrap gap-3 text-sm font-semibold text-[#31313c]">
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm ring-1 ring-black/5">
                  <Icon name="mdi:account-group" class="h-5 w-5 text-[#713478]" />
                  1 - 4 personas
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm ring-1 ring-black/5">
                  <Icon name="mdi:clock-outline" class="h-5 w-5 text-[#713478]" />
                  1h
                </span>
              </div>
              <a
                href={clasesUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-br from-[#713478] to-[#b76cbf] px-5 py-3 text-sm font-bold text-white shadow-[0_8px_18px_rgba(113,52,120,0.24)] transition-all duration-300 hover:-translate-y-0.5 hover:brightness-110"
              >
                <Icon name="mdi:school-outline" class="h-5 w-5" />
                Pedir informacion
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1120px] px-5 py-14 md:px-8 md:py-16">
      <div class="border-t border-black/10 pt-8">
        <div class="mb-6 max-w-[620px]">
          <span class="mb-3 inline-flex rounded-full bg-[#f2eef4] px-4 py-1 text-xs font-bold uppercase tracking-[0.16em] text-[#713478]">
            Siguiente paso
          </span>
          <h3 class="text-2xl font-bold leading-tight text-[#31313c]">
            Agenda segun tu plan
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6f6f7d]">
            Reserva una cancha para jugar o pregunta por clases. Si necesitas
            revisar disponibilidad, abre los horarios antes de escribirnos.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          <a
            href={reservaCanchaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl bg-[#713478] px-5 py-5 text-white shadow-[0_12px_30px_rgba(113,52,120,0.22)] transition-all duration-300 hover:-translate-y-0.5"
          >
            <span class="font-bold">Reservar cancha</span>
            <Icon name="mdi:calendar-check" class="h-6 w-6" />
          </a>
          <a
            href={clasesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-xl bg-white px-5 py-5 text-[#31313c] shadow-sm ring-1 ring-black/5 transition-all duration-300 hover:-translate-y-0.5 hover:text-[#713478]"
          >
            <span class="font-bold">Pedir clase</span>
            <Icon name="mdi:school-outline" class="h-6 w-6 text-[#713478]" />
          </a>
          <div class="[&>button]:h-full [&>button]:rounded-xl [&>button]:border-[#713478]/25 [&>button]:bg-white [&>button]:px-5 [&>button]:py-5 [&>button]:text-[#31313c] [&>button]:shadow-sm [&>button]:ring-1 [&>button]:ring-black/5 [&>button_span]:justify-between">
            <ButtonModal />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>("[data-autoplay-video]");

  function loadVideo(video: HTMLVideoElement) {
    if (video.dataset.loaded === "true") return;
    const src = video.dataset.src;
    if (!src) return;
    video.src = src;
    video.dataset.loaded = "true";
    video.play().catch(() => undefined);
  }

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const video = entry.target as HTMLVideoElement;
          loadVideo(video);
          observer.unobserve(video);
        });
      },
      { rootMargin: "250px 0px" }
    );

    videos.forEach((video) => observer.observe(video));
  } else {
    videos.forEach(loadVideo);
  }
</script>
