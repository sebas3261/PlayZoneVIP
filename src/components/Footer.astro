---
import { Icon } from "astro-icon/components";

const itemHover =
  "inline-block transition-all duration-300 hover:scale-110 hover:text-[#F35723] hover:drop-shadow-[0_0_6px_rgba(255,209,102,0.7)] text-sm md:text-base";
---

<footer role="contentinfo" class="font-text text-white p-10 px-8 md:px-20">
  <div class="border-b border-white/50 flex flex-col py-5 justify-between gap-8 md:flex-row">
    <div>
      <h2 class="font-title text-2xl mb-1">PLAYZONE VIP</h2>
      <p class="max-w-[48ch] mb-6 text-sm md:text-base">
        Tu centro de entretenimiento deportivo donde la diversión no tiene
        límites. fútbol, pádel, paintball y escape room en un solo lugar.
      </p>

      <div class="flex gap-3 mb-5">
        <a
          href="https://www.facebook.com/playzonevip10"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class={`${itemHover} hover:!text-[#1877F2] hover:!drop-shadow-[0_0_6px_rgba(24,119,242,0.6)]`}
        >
          <Icon name="ic:baseline-facebook" class="w-6 h-6" aria-hidden="true" />
        </a>

        <a
          href="https://www.instagram.com/playzonevip10"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class={`${itemHover} hover:!text-[#E1306C] hover:!drop-shadow-[0_0_6px_rgba(225,48,108,0.6)]`}
        >
          <Icon name="mdi:instagram" class="w-6 h-6" aria-hidden="true" />
        </a>

        <a
          href="https://x.com/playzonevip"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class={`${itemHover} hover:!text-[#1DA1F2] hover:!drop-shadow-[0_0_6px_rgba(29,161,242,0.6)]`}
        >
          <Icon name="prime:twitter" class="w-6 h-6" aria-hidden="true" />
        </a>

        <a
          href="https://wa.me/573132485526"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class={`${itemHover} hover:!text-[#25D366] hover:!drop-shadow-[0_0_6px_rgba(37,211,102,0.6)]`}
        >
          <Icon name="ic:baseline-whatsapp" class="w-6 h-6" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-8 sm:flex-row sm:gap-12">
      <nav aria-label="Enlaces rápidos">
        <h3 class="font-semibold mb-2">Enlaces rápidos</h3>
        <div class="flex gap-10">
          <ul class="flex flex-col gap-1">
            <li><a href="/" class={itemHover}>Inicio</a></li>
            <li><a href="/actividades" class={itemHover}>Actividades</a></li>
            <li><a href="/fiestasinfantiles" class={itemHover}>Fiestas infantiles</a></li>
            <li><a href="/canchas" class={itemHover}>Fútbol</a></li>
          </ul>
          <ul class="flex flex-col gap-1">
            <li><a href="/padel" class={itemHover}>Pádel</a></li>
            <li><a href="/paintball" class={itemHover}>Paintball</a></li>
            <li><a href="/escaperoom-game" class={itemHover}>Escape Room</a></li>
            <li><a href="/contacto" class={itemHover}>Contacto</a></li>
          </ul>
        </div>
      </nav>

      <address class="not-italic">
        <h3 class="font-semibold mb-2">Contacto</h3>
        <ul class="flex flex-col gap-2 text-xs">
          <li class="flex items-start gap-2">
            <Icon name="mdi:location" class="w-5 h-5 mt-0.5" aria-hidden="true" />
            <a
              href="https://maps.google.com/?q=PlayZone+VIP+Ch%C3%ADa+Cra+9+Vereda+Bojac%C3%A1"
              target="_blank"
              rel="noopener noreferrer"
            >
              Cra. 9, Vereda Bojacá / Km 1 vía Chía–Cajicá, Chía, Cundinamarca
            </a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="ic:baseline-phone" class="w-5 h-5" aria-hidden="true" />
            <a href="tel:+573132485526">+57 313 248 5526</a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="mdi:clock-outline" class="w-5 h-5" aria-hidden="true" />
            <span>L–D 8:00 AM – 11:00 PM</span>
          </li>
        </ul>
      </address>
    </div>
  </div>
  <div class="mt-5 flex justify-between flex-col md:flex-row">
    <div>
      <p>
        © 2025 - Play Zone VIP by
        <a
          href="https://www.linkedin.com/in/sebastian-sanchez-sandoval-3ab3b327a"
          target="_blank"
          rel="noopener noreferrer"
        >
          Sebastian Sanchez
        </a>
      </p>
    </div>
    <ul class="flex flex-col gap-1 mt-2 sm:flex-row sm:gap-4 md:mt-0">
      <li><a href="/cookies" class={itemHover}>Cookies</a></li>
      <li><a href="/politica-privacidad" class={itemHover}>Política de privacidad</a></li>
      <li><a href="/aviso-legal" class={itemHover}>Aviso legal</a></li>
    </ul>
  </div>
</footer>
