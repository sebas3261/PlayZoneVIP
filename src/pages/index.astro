---
import Layout from "@/layouts/Layout.astro";
import HomeBoxes from "@/components/HomeBoxes.astro";
import HomeSelectUs from "@/components/HomeSelectUs.astro";
import Title from "@/components/Title.astro";
import { Icon } from "astro-icon/components";

const items = [
  {
    icon: "bi:shield-check",
    title: "Instalaciones Seguras",
    description:
      "Todas nuestras instalaciones cumplen con los más altos estándares de seguridad.",
  },
  {
    icon: "iconamoon:star-light",
    title: "Calidad Premium",
    description:
      "Equipamiento de última generación y mantenimiento constante de todas las áreas.",
  },
  {
    icon: "tabler:clock",
    title: "Horarios Flexibles",
    description:
      "Abierto todos los días con horarios amplios para adaptarse a tu agenda.",
  },
  {
    icon: "octicon:people-24",
    title: "Para Toda la Familia",
    description:
      "Actividades y espacios diseñados para todas las edades y niveles.",
  },
];

const waUrl = `https://wa.me/573132485526?text=${encodeURIComponent(
  "Hola, quiero saber más sobre las actividades de Playzone VIP"
)}`;
---

<Layout>
  <main class="overflow-hidden bg-white">
    <section class="relative h-[560px] md:h-[670px] flex items-center">
      <img
        src="/images/Home/Hero/MainHome.webp"
        srcset="/images/optimized/home/MainHome-900.webp 900w, /images/optimized/home/MainHome-1400.webp 1400w, /images/Home/Hero/MainHome.webp 1600w"
        sizes="100vw"
        alt="Playzone VIP - Deportes y Aventuras en Chía"
        width="1600"
        height="1200"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover object-left-top lg:object-center"
      />

      <div class="absolute inset-0 z-10 bg-gradient-to-r from-black/58 via-black/34 to-black/10"></div>
      <div class="absolute inset-x-0 bottom-0 z-10 h-28 bg-gradient-to-t from-white to-transparent"></div>

      <div class="relative z-20 px-8 flex max-w-[980px] flex-col gap-3 md:px-20 lg:ml-40 lg:px-0">
        <span class="w-fit rounded-full border border-white/30 bg-white/15 px-4 py-1 text-xs font-bold uppercase tracking-[0.18em] text-white backdrop-blur">
          Chia - Cajica
        </span>
        <h2 class="text-white text-5xl font-title leading-none md:text-7xl lg:text-8xl">
          Playzone VIP
        </h2>
        <p class="font-text text-white/95 font-semibold text-sm leading-6 md:max-w-[560px] lg:max-w-[760px] lg:text-lg">
          Fútbol, Pádel, Paintball y Escape Room. Cuatro experiencias únicas
          en un solo lugar. Vive la emoción del deporte y la aventura.
        </p>

        <div class="mt-2 flex flex-col w-fit gap-3 md:flex-row">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white px-5 py-3 rounded-lg font-text font-bold text-sm flex items-center justify-center gap-2 cursor-pointer shadow-[0_12px_30px_rgba(0,0,0,0.24)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#f2eef4] md:text-base"
          >
            <Icon name="mdi:calendar-outline" class="h-5 w-5 text-[#713478]" />
            Reservar ahora
          </a>
          <a
            href="/actividades"
            class="border border-white/45 bg-white/10 px-5 py-3 rounded-lg font-text font-bold text-sm text-white backdrop-blur flex items-center justify-center gap-2 cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/20 md:text-base"
          >
            <Icon name="solar:widget-6-linear" class="h-5 w-5" />
            Ver actividades
          </a>
        </div>

      </div>
    </section>

    <section class="bg-white">
      <Title
        titulo="Nuestras Actividades"
        subTitulo="Cuatro formas de vivir la adrenalina"
        descripcion="Vive la emoción del deporte como nunca antes. Cada experiencia en PlayZone VIP está diseñada para despertar tu espíritu competitivo y hacerte sentir la adrenalina del juego."
      />
    </section>

    <section
      class="scroll-hide bg-white flex gap-7 overflow-x-auto snap-x snap-mandatory scroll-smooth px-5 pb-16 pt-4 justify-start md:justify-start lg:justify-center md:overflow-x-auto xl:overflow-x-visible"
      aria-label="Actividades"
    >
      <div class="snap-center shrink-0">
        <HomeBoxes
          image="/images/Home/ActivityCards/futbolHome.webp"
          srcSet="/images/optimized/home/futbolHome-520.webp 520w, /images/Home/ActivityCards/futbolHome.webp 1280w"
          activity="Fútbol"
          description="Canchas profesionales de césped sintético de última generación, iluminación LED"
          link="/canchas"
        />
      </div>

      <div class="snap-center shrink-0">
        <HomeBoxes
          image="/images/Home/ActivityCards/padelHome.webp"
          srcSet="/images/optimized/home/padelHome-520.webp 520w, /images/Home/ActivityCards/padelHome.webp 1280w"
          activity="Padel"
          description="Disfruta de modernas canchas de pádel techadas y con iluminación de torneo."
          link="/padel"
        />
      </div>

      <div class="snap-center shrink-0">
        <HomeBoxes
          image="/images/Home/ActivityCards/paintballHome.webp"
          srcSet="/images/optimized/home/paintballHome-520.webp 520w, /images/Home/ActivityCards/paintballHome.webp 1000w"
          activity="Paintball"
          description="Campos de batalla con escenarios únicos, equipamiento de protección completo y bolas de pintura."
          link="/paintball"
        />
      </div>

      <div class="snap-center shrink-0">
        <HomeBoxes
          image="/images/Home/ActivityCards/escapeHome.webp"
          srcSet="/images/optimized/home/escapeHome-520.webp 520w, /images/Home/ActivityCards/escapeHome.webp 1200w"
          activity="Escape Room"
          description="Salas inmersivas con tecnología de última generación, acertijos desafiantes y aventuras que pondrán a prueba tu ingenio."
          link="/escaperoom-game"
        />
      </div>
    </section>

    <section class="bg-[#f7f7fa] border-y border-black/5">
      <Title
        titulo="Por qué elegirnos"
        subTitulo="La mejor experiencia deportiva"
        descripcion="En PlayZone VIP nos dedicamos a ofrecer instalaciones de primera calidad y un servicio excepcional para que disfrutes al máximo de tu tiempo deportivo y de ocio."
      />
    </section>

    <section class="bg-[#f7f7fa] pb-14">
      <div class="scroll-hide overflow-x-auto px-5 scroll-smooth snap-x snap-mandatory md:px-6">
        <div class="mx-auto flex w-max gap-5 py-2 snap-x snap-mandatory">
        {items.map((item, i) => (
          <div
            class="snap-center flex-shrink-0"
            data-index={i}
          >
            <HomeSelectUs icon={item.icon} title={item.title} description={item.description} />
          </div>
        ))}
        </div>
      </div>
    </section>

    <section class="bg-white px-5 py-12 font-text md:px-8 lg:py-18">
      <div class="mx-auto flex max-w-[1120px] flex-col items-center gap-9 lg:flex-row-reverse">
        <div class="relative w-full lg:w-[52%]">
          <img
            src="/images/Home/Nosotros/nosotros.webp"
            srcset="/images/optimized/home/nosotros-900.webp 900w, /images/Home/Nosotros/nosotros.webp 1600w"
            sizes="(min-width: 1024px) 52vw, 100vw"
            alt="Nosotros en Playzone VIP"
            width="638"
            height="422"
            loading="lazy"
            decoding="async"
            class="h-[300px] w-full rounded-xl object-cover shadow-[0_22px_60px_rgba(18,18,28,0.16)] md:h-[420px]"
          />
          <div class="absolute bottom-4 left-4 rounded-lg bg-white/92 px-4 py-3 shadow-[0_14px_35px_rgba(0,0,0,0.18)] backdrop-blur">
            <span class="block text-2xl font-bold text-[#713478]">10+</span>
            <span class="text-xs font-semibold text-[#626271]">Años creando experiencias</span>
          </div>
        </div>
        <div class="flex flex-col gap-5 justify-center items-center lg:w-[48%] lg:items-start">
          <div class="bg-[#E9EBEF] px-5 py-1 rounded-full">
            <h3 class="font-title text-sm">Sobre nosotros</h3>
          </div>
          <h3 class="text-2xl font-bold text-center lg:text-start">
            Más de 10 años creando momentos inolvidables
          </h3>
          <p class="text-center text-[#6f6f7d] text-sm leading-6 lg:text-start">
            PlayZone nació con la visión de crear un espacio donde el deporte,
            la diversión y la familia se unieran en perfecta armonía. Durante
            más de una década hemos sido el hogar de miles de deportistas,
            familias y celebraciones especiales.
          </p>
          <p class="text-center text-[#6f6f7d] text-sm leading-6 lg:text-start">
            Nuestras instalaciones de última generación incluyen canchas de
            fútbol y pádel profesionales, emocionantes campos de paintball,
            desafiantes escape rooms y espacios perfectos para fiestas
            infantiles que harán realidad los sueños de los más pequeños.
          </p>
          <div class="grid w-full max-w-[360px] grid-cols-2 gap-3 md:max-w-[420px]">
            <div class="flex flex-col justify-center items-center rounded-lg bg-[#f7f7fa] px-4 py-4">
              <h4 class="font-bold text-xl">10+</h4>
              <p class="text-[#828292] text-xs">Años de experiencia </p>
            </div>
            <div class="flex flex-col justify-center items-center rounded-lg bg-[#f7f7fa] px-4 py-4">
              <h4 class="font-bold text-xl">4</h4>
              <p class="text-[#828292] text-xs">Actividades Principales</p>
            </div>
          </div>
          <a
            href="/actividades"
            class="text-white rounded-sm py-2 px-5 text-sm cursor-pointer font-semibold bg-gradient-to-br from-[#713478] to-[#b76cbf] shadow-[0_4px_10px_rgba(0,0,0,0.3)] hover:shadow-[0_6px_15px_rgba(0,0,0,0.4)] hover:brightness-110 active:translate-y-[1px] transition-all duration-300 flex items-center gap-2"
          >
            <Icon name="solar:widget-6-linear" class="w-5 h-5" />
            Conoce nuestras actividades
          </a>
        </div>
      </div>
    </section>

    <section class="bg-white px-5 pb-16 md:px-10 lg:px-40">
      <div class="bg-[#713478] text-white px-6 py-7 font-text shadow-[0_22px_60px_rgba(113,52,120,0.24)] md:rounded-xl md:px-8 md:py-8 lg:rounded-2xl">
        <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-[650px]">
            <h3 class="text-2xl font-bold leading-tight">
              ¿Listo para vivir la experiencia PlayZone?
            </h3>
            <p class="mt-3 text-sm font-semibold leading-6 text-white/85">
              Ya sea para un partido con amigos, una celebración especial o
              simplemente para pasar un buen rato, estamos aquí para hacer
              realidad tu plan perfecto.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white text-[#713478] font-bold flex items-center gap-2 px-5 py-3 rounded-lg min-w-[190px] text-sm justify-center cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#f2eef4]"
            >
              <Icon name="mdi:calendar-outline" class="h-5 w-5" />
              Reservar ahora
            </a>
            <a
              class="border border-white/35 bg-white/10 text-white font-bold px-5 py-3 rounded-lg min-w-[190px] text-sm cursor-pointer flex items-center justify-center gap-2 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/20"
              href="/contacto"
            >
              <Icon name="mdi:information-outline" class="h-5 w-5" />
              Más información
            </a>
          </div>
        </div>

        <ul class="mt-7 grid gap-3 border-t border-white/15 pt-5 text-xs font-semibold md:grid-cols-3">
          <li class="flex items-center gap-2 rounded-lg bg-white/10 px-4 py-3">
            <Icon name="ic:baseline-phone" class="h-5 w-5 shrink-0" aria-hidden="true" />
            <a href="tel:+573132485526">+57 313 248 5526</a>
          </li>
          <li class="flex items-center gap-2 rounded-lg bg-white/10 px-4 py-3">
            <Icon name="mdi:location" class="h-5 w-5 shrink-0" aria-hidden="true" />
            <a
              href="https://maps.google.com/?q=PlayZone+VIP+Ch%C3%ADa+Crr+9n+Vereda+Bojac%C3%A1"
              target="_blank"
              rel="noopener noreferrer"
            >
              Crr. 9n, Vereda Bojacá / Km 1 vía Chía-Cajicá
            </a>
          </li>
          <li class="flex items-center gap-2 rounded-lg bg-white/10 px-4 py-3">
            <Icon name="mdi:clock-outline" class="h-5 w-5 shrink-0" aria-hidden="true" />
            <span>L–D 8:00 AM – 11:00 PM</span>
          </li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
