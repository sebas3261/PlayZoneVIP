---
interface Props {
  image: string;
  activity: string;
  description: string;
  link: string;
}

const { image, activity, description, link } = Astro.props;
---

<div
  class="h-[300px] w-[300px] rounded-[20px] overflow-hidden
         shadow-[0_4px_10px_3px_rgba(0,0,0,0.3)] flex flex-col
         transform transition-all duration-500 ease-out
         hover:scale-[1.03] hover:shadow-[0_6px_16px_6px_rgba(0,0,0,0.35)]"
>
  <div class="relative h-[168px] flex items-end p-2">
    <img
      src={image}
      alt={activity}
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative text-white font-bold text-lg z-10">
      {activity}
    </div>
  </div>

  <div class="flex flex-col justify-between flex-1 py-3 px-2">
    <p class="text-sm text-[#828292]">{description}</p>
    <a
      href={link}
      class="mt-auto text-white rounded-3xl py-2 px-5 text-sm mx-3 cursor-pointer font-semibold
             bg-gradient-to-br from-[#713478] to-[#b76cbf]
             shadow-[0_4px_10px_rgba(0,0,0,0.3)]
             hover:shadow-[0_6px_15px_rgba(0,0,0,0.4)]
             hover:brightness-110 active:translate-y-[1px]
             transition-all duration-300 flex items-center justify-center"
    >
      Ver más
    </a>
  </div>
</div>
